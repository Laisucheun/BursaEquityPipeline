# Copy to .env and fill in. Never commit .env.

# --- Database -----------------------------------------------------------
# Default: zero-setup local SQLite. The schema is Postgres-compatible, so
# switching is a one-line change once you have a Postgres instance:
#   DATABASE_URL=postgresql+psycopg://bursa:bursa@localhost:5432/bursa
# (then: uv sync --extra postgres)
DATABASE_URL=sqlite+pysqlite:///./bursa.sqlite

# --- Blob storage -------------------------------------------------------
# local | r2
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
INBOX_DIR=./inbox

# Only when STORAGE_BACKEND=r2 (requires: uv sync --extra aws)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Anthropic ----------------------------------------------------------
# Leave unset if you have run `ant auth login` - the SDK picks up the profile.
# ANTHROPIC_API_KEY=

# Model used to map row labels to canonical concepts. Never sees numbers.
MAPPER_MODEL=claude-opus-5
MAPPER_EFFORT=high

# --- Extraction ---------------------------------------------------------
# Rows below this confidence go to the review queue instead of being published.
MIN_MAPPING_CONFIDENCE=0.80
# Validation tolerance, in units of the document's reported scale.
VALIDATION_TOLERANCE_UNITS=1.0

# --- Scraper (src/bursa/scrapers/) ---------------------------------------
# bursamalaysia.com sits behind a Cloudflare CAPTCHA that cannot be automated
# past - the scraper targets company investor-relations sites only. Put real
# contact details in the User-Agent; an anonymous/spoofed one is bad practice.
SCRAPER_USER_AGENT=BursaEquityPipeline-Research/0.1 (contact: you@example.com)
SCRAPER_MIN_DELAY_SECONDS=1.0
SCRAPER_MAX_CONCURRENCY=8
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=20.0
